<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen Theme. -->
    <style name="UiTheme.AppSplash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/md_white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ui_splash_background</item>
        <item name="windowSplashScreenAnimationDuration">300</item>

        <item name="postSplashScreenTheme">@style/UiTheme.ShortX</item>

        <item name="android:statusBarColor">@color/md_white</item>
        <item name="android:navigationBarColor">@color/md_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>