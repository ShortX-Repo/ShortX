<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.vending.CHECK_LICENSE" />

    <application android:theme="@style/UiTheme.ShortX">

        <activity
            android:name=".main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".shortcut.ActionShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/UiTheme.Shortcut" />

        <activity
            android:name="tornaco.apps.shortx.ui.share.ViewerActivity"
            android:excludeFromRecents="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>
        <activity
            android:name="tornaco.apps.shortx.ui.gvar.GlobalVarListActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.gvar.GlobalVarDetailActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.settings.danmu.DanmuUISettingsActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.pkgset.PkgSetListActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.pkgset.PkgSetDetailActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.record.ActionEvaRecordActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.record.FactPublishRecordActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.record.ConditionEvaRecordActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.addrule.AddRuleActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.addda.AddDirectActionActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.subscribe.SubscribeActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.subscribe.LVLCheckActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.record.AudioRecordActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.addrule.action.selector.ActionSelectorActivity"
            android:exported="false" />
        <activity
            android:name="tornaco.apps.shortx.ui.gesture.GestureRecorderActivity"
            android:exported="false" />

        <service
            android:name="tornaco.apps.shortx.ui.service.ShellService"
            android:exported="true"
            tools:ignore="ExportedService" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="tornaco.apps.shortx"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ui_file_paths" />
        </provider>
    </application>
</manifest>