<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:theme="@style/UiTheme.ShortX">

        <activity
            android:name=".main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".demo.DemoActivity"
            android:exported="false"
            android:label="Demo">
            <intent-filter>
                <action android:name="tornaco.apps.shortx.action.demo" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".shortcut.ActionShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/UiTheme.Shortcut" />

        <service
            android:name="tornaco.apps.shortx.ui.service.ShellService"
            android:exported="true"
            tools:ignore="ExportedService" />
    </application>
</manifest>