<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INSTALL_SHORTCUT" />

    <application>
        <activity
            android:name=".ui.demo.DemoActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_demo"
            android:label="Demo"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/ic_launcher_demo_round"
            android:taskAffinity="ui.demo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.demo.ComposeDemoActivity"
            android:exported="false"
            android:icon="@mipmap/ic_launcher_demo"
            android:label="Demo"
            android:roundIcon="@mipmap/ic_launcher_demo_round" />

        <activity
            android:name=".ui.demo.PickRingtoneActivity"
            android:exported="false"
            android:icon="@mipmap/ic_launcher_demo"
            android:label="Demo"
            android:roundIcon="@mipmap/ic_launcher_demo_round" />

        <activity
            android:name=".ui.demo.PieDemoActivity"
            android:exported="false"
            android:icon="@mipmap/ic_launcher_demo"
            android:label="Demo"
            android:roundIcon="@mipmap/ic_launcher_demo_round" />

    </application>

</manifest>